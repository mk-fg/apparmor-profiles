#include <tunables/global>

profile pgrep /usr/bin/pgrep {
	/usr/bin/pgrep rm,
	/usr/lib/** rm,
	/etc/ld.so.* r,
	/usr/share/locale/** r,

	capability sys_ptrace,
	deny ptrace,
	/proc/tty/drivers r,
	/sys/devices/system/{node,cpu/possible} r,

	/proc/ r,
	/proc/self/status r,
	/proc/@{pid}/{,**} r,
}

profile pkill /usr/bin/pkill {
	/usr/bin/pgrep rm,
	/usr/lib/** rm,
	/etc/ld.so.* r,
	/usr/share/locale/** r,

	capability sys_ptrace,
	deny ptrace,
	/proc/tty/drivers r,
	/sys/devices/system/{node,cpu/possible} r,

	/proc/ r,
	/proc/self/status r,
	/proc/@{pid}/{,**} r,

	signal (send),
}
