#include <tunables/global>

profile pgrep /usr/bin/pgrep {
	/usr/bin/pgrep rm,
	/usr/lib/** rm,
	/etc/ld.so.* r,
	/usr/share/locale/** r,

	capability sys_ptrace dac_read_search,
	ptrace read, # required for /proc/<pid>/environ
	/proc/tty/drivers r,
	/sys/devices/system/{node,cpu/possible} r,

	/proc/ r,
	/proc/self/status r,
	/proc/@{pid}/{,**} r,

	# pgrep -F <pidfile>
	/**.pid r,
	/**/pid r,
}

profile pkill /usr/bin/pkill {
	/usr/bin/pgrep rm,
	/usr/lib/** rm,
	/etc/ld.so.* r,
	/usr/share/locale/** r,

	capability sys_ptrace dac_read_search kill,
	ptrace read, # required for /proc/<pid>/environ
	/proc/tty/drivers r,
	/sys/devices/system/{node,cpu/possible} r,

	/proc/ r,
	/proc/self/status r,
	/proc/@{pid}/{,**} r,

	signal send,

	# pkill -F <pidfile>
	/**.pid r,
	/**/pid r,
}
